{
  "name": "Default branch: people merge, Thor doesn't",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_type": "OrganizationAdmin", "actor_id": 1, "bypass_mode": "pull_request" },
    { "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "pull_request" },
    { "actor_type": "RepositoryRole", "actor_id": 2, "bypass_mode": "pull_request" },
    { "actor_type": "RepositoryRole", "actor_id": 4, "bypass_mode": "pull_request" }
  ],
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] },
    "repository_name": { "include": ["~ALL"], "exclude": [] }
  },
  "rules": [
    { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } }
  ]
}
