{
  "name": "thorai/ branches: only Thor updates",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_type": "Integration",
      "actor_id": 5505187,
      "bypass_mode": "always"
    },
    {
      "actor_type": "OrganizationAdmin",
      "actor_id": 1,
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/thorai/**"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    }
  ]
}
